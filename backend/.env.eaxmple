PORT=8000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173
# proxy এর পেছনে হলে 1
TRUST_PROXY=

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# এই email দিয়ে register করলে Super Admin হবে
SUPER_ADMIN_EMAIL=

# ---- নতুন ----
# OTP hash এর secret (না দিলে ACCESS_TOKEN_SECRET ব্যবহার হবে)
OTP_SECRET=

# Kill switch এর নিজস্ব password — HASH দেওয়াই ভালো। বানাতে:
# node -e "import('bcrypt').then(b=>b.default.hash('YOUR_PASSWORD',10).then(console.log))"
KILL_SWITCH_PASSWORD_HASH=
# (hash না দিলে plain password, কম নিরাপদ)
KILL_SWITCH_PASSWORD=

# Countdown সেকেন্ডে (default 600 = ১০ মিনিট)
KILL_COUNTDOWN_SECONDS=600
# code ডিলিট সবসময় বন্ধ রাখতে false
KILL_ALLOW_CODE_DELETE=false
# true দিলে কিছুই ডিলিট হবে না, শুধু পুরো flow + countdown test করা যাবে
KILL_DRY_RUN=false