# ============================================================
# Email Sender — backend/.env নমুনা
# local এ: এটা কপি করে `backend/.env` নাম দাও (.env GitHub এ যায় না)
# Render এ: এই মানগুলোই Environment ট্যাবে বসাও
# ============================================================

# ---- Server ----
# local এ 3000 (frontend dev এও এটাই ধরা আছে)। Render নিজে PORT দেয়, ওখানে এটা দিও না
PORT=3000
# local dev এ frontend এর ঠিকানা। Render এ ফাঁকা রাখো (frontend + backend একই origin)
CORS_ORIGIN=http://localhost:5173
# ভিজিটরের আসল IP: Render এ কিছুই সেট করতে হয় না — কোড নিজেই Cloudflare এর CF-Connecting-IP header পড়ে।
# অন্য host এ হলে সেই host এর "আসল IP" header এর নাম দাও (যেমন x-real-ip)। বন্ধ করতে: none
CLIENT_IP_HEADER=
# শুধু অন্য কোনো proxy চেইন থাকলে (Render এ দরকার নেই, এটা IP জাল করার সুযোগ দেয় না এমন host এ ব্যবহার করো)
TRUST_PROXY=

# ---- MongoDB Atlas ----
# Atlas এর দেওয়া লিংক যেমন আছে তেমনই বসানো যায় (শেষে ?retryWrites=... থাকলেও সমস্যা নেই)।
# database এর নাম (email-sender) কোড নিজে বসিয়ে নেয়। password এ বিশেষ চিহ্ন (@ : / ?) থাকলে URL-encode করো
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# ---- Login token ----
# দুটো আলাদা লম্বা random লেখা। বানাতে: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d
# OTP hash এর secret (না দিলে ACCESS_TOKEN_SECRET ব্যবহার হবে)
OTP_SECRET=

# ---- Cloudinary (avatar) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- এই email দিয়ে register করলে Super Admin হবে ----
SUPER_ADMIN_EMAIL=

# ============================================================
# ইমেইল পাঠানো (Render free plan এ SMTP বন্ধ, তাই HTTPS relay)
# ============================================================
# relay | brevo | smtp | auto   (auto = BREVO_API_KEY থাকলে brevo, নাহলে MAIL_RELAY_URL থাকলে relay, নাহলে smtp)
MAIL_PROVIDER=relay

# ---- relay: PythonAnywhere + Gmail (backend/mail-relay-pythonanywhere.py) ----
# শেষে /send দেওয়াই ভালো। MAIL_RELAY_SECRET = PythonAnywhere এর config.py এর RELAY_SECRET এর হুবহু একই মান
MAIL_RELAY_URL=https://USERNAME.pythonanywhere.com/send
MAIL_RELAY_SECRET=

# ---- brevo (ঐচ্ছিক বিকল্প) ----
BREVO_API_KEY=
# প্রেরকের ঠিকানা — শুধু brevo/smtp এ লাগে (relay এ প্রেরক হলো config.py এর GMAIL_USER)
MAIL_FROM=

# ---- SMTP (শুধু local পরীক্ষার জন্য; Render এ কাজ করে না) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================================
# cron-job.org — ঘুমন্ত server জাগিয়ে আটকে থাকা ইমেইল আবার পাঠায় (দিনে ২ বার)
# ============================================================
# একটা লম্বা random লেখা। cron-job.org এর URL এ ?key=এই_মান যাবে
CRON_SECRET=

# ============================================================
# Push notification (ফোনের notification bar)
# ============================================================
# key বানাতে একবার চালাও:  cd backend && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# যেকোনো mailto: বা তোমার সাইটের https লিংক
VAPID_SUBJECT=mailto:you@example.com

# ============================================================
# Kill switch
# ============================================================
# নিজস্ব password — HASH দেওয়াই ভালো। বানাতে:
# node -e "import('bcrypt').then(b=>b.default.hash('YOUR_PASSWORD',10).then(console.log))"
KILL_SWITCH_PASSWORD_HASH=
# (hash না দিলে plain password, কম নিরাপদ)
KILL_SWITCH_PASSWORD=
# Countdown সেকেন্ডে (default 600 = ১০ মিনিট)
KILL_COUNTDOWN_SECONDS=600
# code ডিলিট সবসময় বন্ধ রাখতে false (Render এ code ডিলিট করার দরকার নেই)
KILL_ALLOW_CODE_DELETE=false
# true দিলে কিছুই ডিলিট হবে না, শুধু পুরো flow + countdown test করা যাবে
KILL_DRY_RUN=false
